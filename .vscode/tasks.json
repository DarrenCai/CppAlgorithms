{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "g++",
            "type": "shell",
            "args": ["-g", "${file}", "-o", "${workspaceRoot}/exe/${fileBasenameNoExtension}", "-std=c++11"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}